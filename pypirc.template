# Plantilla de ~/.pypirc  —  cópiala a tu HOME y rellena los tokens.
#
#   cp pypirc.template ~/.pypirc
#   chmod 600 ~/.pypirc          # importante: contiene credenciales
#
# Tokens: pypi.org y test.pypi.org son cuentas SEPARADAS.
#   - Crea un token en  Account settings → API tokens  (requiere 2FA).
#   - El usuario SIEMPRE es __token__ ; el password es el token "pypi-...".
#
# Con esto, `twine upload -r testpypi dist/*` y `twine upload dist/*`
# NO te vuelven a pedir el token.

[distutils]
index-servers =
    pypi
    testpypi

[pypi]
username = __token__
password = pypi-CAMBIA_ESTO_por_tu_token_de_PyPI

[testpypi]
repository = https://test.pypi.org/legacy/
username = __token__
password = pypi-CAMBIA_ESTO_por_tu_token_de_TestPyPI
